# ── Discord ───────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=

# ── Football data source ──────────────────────────────────────────────────
# Free API key from https://www.football-data.org/client/register
FOOTBALL_API_KEY=

# ── Admin / permissions ───────────────────────────────────────────────────
# Discord user ID that always has admin rights (receives error DMs, can run
# owner-only commands even without the admin role). Right-click your name →
# Copy User ID (needs Developer Mode on).
OWNER_ID=

# Comma-separated Discord role names that may run admin commands, e.g. "Mod,Staff".
# Members with any of these roles in a guild are admins there.
ADMIN_ROLES=Admin

# ── Scoring ───────────────────────────────────────────────────────────────
# Points per correct group-stage prediction.
POINTS_GROUP=1
# Points per correct knockout prediction (set >1 to weight knockouts heavier).
POINTS_KNOCKOUT=1

# ── Settlement loop ───────────────────────────────────────────────────────
# How often (seconds) to poll the API for finished matches & sync fixtures.
SETTLE_INTERVAL_SEC=900

# Optional: channel ID where settlement results get broadcast. Blank = no broadcast.
RESULT_CHANNEL_ID=

# ── Feishu export (optional) ──────────────────────────────────────────────
# Only needed if /exportwinners should also push to Feishu IM.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
